use GFX.Assets.Image
use GFX.Color
use GFX.ECS
use GFX.Scene2D
use STD.Math

public class Sprite2D:Node2D {
    private var current_sprite:Scene2D.Sprite
    private var sprite_dirty:bool

    var image:Image.Handle {
        get { return self.current_sprite.image }
        set(value) {
            if self.current_sprite.image == value { return }
            self.current_sprite.image = value
            self.sprite_changed()
        }
    }

    var size:Math.Vec2 {
        get { return self.current_sprite.size }
        set(value) {
            if self.current_sprite.size == value { return }
            self.current_sprite.size = value
            self.sprite_changed()
        }
    }

    var pivot:Math.Vec2 {
        get { return self.current_sprite.pivot }
        set(value) {
            if self.current_sprite.pivot == value { return }
            self.current_sprite.pivot = value
            self.sprite_changed()
        }
    }

    var color:Color {
        get { return self.current_sprite.color }
        set(value) {
            if self.current_sprite.color == value { return }
            self.current_sprite.color = value
            self.sprite_changed()
        }
    }

    var layer:int {
        get { return self.current_sprite.layer }
        set(value) {
            if self.current_sprite.layer == value { return }
            self.current_sprite.layer = value
            self.sprite_changed()
        }
    }

    var depth:float {
        get { return self.current_sprite.depth }
        set(value) {
            if self.current_sprite.depth == value { return }
            self.current_sprite.depth = value
            self.sprite_changed()
        }
    }

    var visible:bool {
        get { return self.current_sprite.visible }
        set(value) {
            if self.current_sprite.visible == value { return }
            self.current_sprite.visible = value
            self.sprite_changed()
        }
    }

    init(
        image:Image.Handle = Image.Handle(),
        name:str = "Sprite2D",
        size:Math.Vec2 = Math.Vec2(1.0),
        pivot:Math.Vec2 = Math.Vec2(0.5),
        color:Color = Color.white(),
        layer:int = 0,
        depth:float = 0.0,
        visible:bool = true
    ):super(name) {
        self.current_sprite = Scene2D.Sprite(
            image:image,
            size:size,
            pivot:pivot,
            color:color,
            layer:layer,
            depth:depth,
            visible:visible
        )
        self.sprite_dirty = false
    }

    func region() Image.Region? { return self.current_sprite.region() }
    func region(value:Image.Region) {
        self.current_sprite.region(value)
        self.sprite_changed()
    }
    func sampling() Scene2D.Sampling { return self.current_sprite.sampling() }
    func sampling(value:Scene2D.Sampling) {
        if self.current_sprite.sampling() == value { return }
        self.current_sprite.sampling(value)
        self.sprite_changed()
    }

    override func mount_components(world:&ECS.World, entity:ECS.Entity) {
        super.mount_components(world, entity)
        world.insert(entity, self.current_sprite)
        self.sprite_dirty = false
    }

    override func synchronize(world:&ECS.World, entity:ECS.Entity) {
        super.synchronize(world, entity)
        if !self.sprite_dirty { return }
        world.insert(entity, self.current_sprite)
        self.sprite_dirty = false
    }

    private func sprite_changed() {
        if self.sprite_dirty { return }
        self.sprite_dirty = true
        self.changed()
    }
}
