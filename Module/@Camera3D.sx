use GFX.ECS
use GFX.Scene3D

public class Camera3D:Node3D {
    private var current_camera:Scene3D.Camera
    private var camera_dirty:bool

    var active:bool {
        get { return self.current_camera.active }
        set(value) {
            if self.current_camera.active == value { return }
            self.current_camera.active = value
            self.camera_changed()
        }
    }

    var vertical_fov:float {
        get { return self.current_camera.vertical_fov }
        set(value) {
            if self.current_camera.vertical_fov == value { return }
            self.current_camera.vertical_fov = value
            self.camera_changed()
        }
    }

    var near_plane:float {
        get { return self.current_camera.near_plane }
        set(value) {
            if self.current_camera.near_plane == value { return }
            self.current_camera.near_plane = value
            self.camera_changed()
        }
    }

    var far_plane:float {
        get { return self.current_camera.far_plane }
        set(value) {
            if self.current_camera.far_plane == value { return }
            self.current_camera.far_plane = value
            self.camera_changed()
        }
    }

    var order:int {
        get { return self.current_camera.order }
        set(value) {
            if self.current_camera.order == value { return }
            self.current_camera.order = value
            self.camera_changed()
        }
    }

    init(
        name:str = "Camera3D",
        active:bool = true,
        vertical_fov:float = 1.04719758,
        near_plane:float = 0.1,
        far_plane:float = 1000.0,
        order:int = 0
    ):super(name) {
        self.current_camera = Scene3D.Camera(
            active:active,
            vertical_fov:vertical_fov,
            near_plane:near_plane,
            far_plane:far_plane,
            order:order
        )
        self.camera_dirty = false
    }

    func use_perspective() {
        if !self.current_camera.is_orthographic() { return }
        self.current_camera.use_perspective()
        self.camera_changed()
    }

    func use_orthographic(height:float) {
        self.current_camera.use_orthographic(height)
        self.camera_changed()
    }

    func is_orthographic() bool {
        return self.current_camera.is_orthographic()
    }

    override func mount_components(world:&ECS.World, entity:ECS.Entity) {
        super.mount_components(world, entity)
        world.insert(entity, self.current_camera)
        self.camera_dirty = false
    }

    override func synchronize(world:&ECS.World, entity:ECS.Entity) {
        super.synchronize(world, entity)
        if !self.camera_dirty { return }
        world.insert(entity, self.current_camera)
        self.camera_dirty = false
    }

    private func camera_changed() {
        if self.camera_dirty { return }
        self.camera_dirty = true
        self.changed()
    }
}
