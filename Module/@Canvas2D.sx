use GFX.Canvas
use GFX.ECS
use GFX.Scene2D

public class Canvas2D:Node2D {
    private var drawing:Canvas.Canvas
    private var current_visible:bool
    private var visibility_dirty:bool

    var visible:bool {
        get { return self.current_visible }
        set(value) {
            if self.current_visible == value { return }
            self.current_visible = value
            self.visibility_dirty = true
            self.changed()
        }
    }

    init(name:str = "Canvas2D"):super(name) {
        self.drawing = Canvas.Canvas()
        self.current_visible = true
        self.visibility_dirty = false
    }

    func canvas() Canvas.Canvas { return self.drawing }

    func paint(callback:func(&Canvas.Painter)) {
        self.drawing.paint(callback)
    }

    func clear() { self.drawing.clear() }
    func command_count() int { return self.drawing.command_count() }

    override func mount_components(world:&ECS.World, entity:ECS.Entity) {
        super.mount_components(world, entity)
        var placement = Scene2D.Canvas(self.drawing)
        placement.visible = self.current_visible
        world.insert(entity, move placement)
        self.visibility_dirty = false
    }

    override func synchronize(world:&ECS.World, entity:ECS.Entity) {
        super.synchronize(world, entity)
        if !self.visibility_dirty { return }
        var placement = Scene2D.Canvas(self.drawing)
        placement.visible = self.current_visible
        world.insert(entity, move placement)
        self.visibility_dirty = false
    }
}
