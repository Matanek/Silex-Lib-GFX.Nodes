use GFX.Application
use GFX.ECS
use GFX.Input
use Interop.C

public struct Plugin:Application.Plugin {
    private var root_node:Node

    init(root:Node) {
        self.root_node = root
    }

    func id() str { return "GFX.Nodes.Plugin" }

    func build(application:&Application) {
        application.add_plugin(ECS.Plugin())
        application.add_plugin(Application.Time())
        application.add_resource(SceneTree(self.root_node))
        application.add_system(Application.Schedule.startup, bind_node_input)
        application.add_system(Application.Schedule.startup, start_nodes)
        application.add_system(Application.Schedule.update, update_nodes, process_mode:GFX.Application.ProcessMode.always)
        application.add_system(Application.Schedule.shutdown, stop_nodes)
    }
}

func bind_node_input(application:Application) {
    var resources = application.resources()
    var input:Input.State? = null
    {
        if let state = resources.try_get<Input.State>() { input = state }
    }
    var tree = resources.get_mut<SceneTree>()
    tree.bind_input(input)
}

// Node callbacks may access arbitrary resources. Application callbacks declare
// that broad access to the scheduler, so they cannot overlap typed systems.
// Each store handle is shared, not copied storage. Separate handles give the
// tree and World independent lexical borrows under the current root-based
// borrow rules; they can be merged when Resources supports disjoint slot borrows.
func start_nodes(application:Application) {
    var resources = application.resources()
    var world_resources = application.resources()
    let resources_address = C.object_address(resources)
    var tree = resources.get_mut<SceneTree>()
    var world = world_resources.get_mut<ECS.World>()
    tree.begin_callbacks(resources_address)
    tree.start(world)
    tree.end_callbacks()
}

func update_nodes(application:Application) {
    var resources = application.resources()
    let paused = resources.get<Application.Simulation>().is_paused()
    var world_resources = application.resources()
    let resources_address = C.object_address(resources)
    var delta = 0.0
    {
        let time = resources.get<Application.FrameTime>()
        delta = time.delta
    }
    var tree = resources.get_mut<SceneTree>()
    var world = world_resources.get_mut<ECS.World>()
    tree.begin_callbacks(resources_address)
    tree.process(delta, paused, world)
    tree.end_callbacks()
}

func stop_nodes(application:Application) {
    var resources = application.resources()
    var world_resources = application.resources()
    let resources_address = C.object_address(resources)
    var tree = resources.get_mut<SceneTree>()
    var world = world_resources.get_mut<ECS.World>()
    tree.begin_callbacks(resources_address)
    tree.stop(world)
    tree.end_callbacks()
}

contribute GFX.Plugins {
    public use GFX.Nodes.Plugin as Nodes
}
