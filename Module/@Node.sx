use GFX.ECS
use STD.Text

// Dimension-independent scene-tree identity and lifecycle.

public class Node {
    private let current_name:str
    private var current_parent:Node? = null
    private var current_children:Node[]
    private var current_entity:ECS.Entity? = null
    private var current_tree:SceneTree? = null
    private var current_inside_tree:bool
    private var current_dirty:bool
    private var current_synchronization_registered:bool
    private var current_process_enabled:bool
    private var current_process_configured:bool
    private var current_process_registered:bool
    private var current_processing:bool
    private var current_ready_count:int
    private var current_process_delta:float

    init(name:str = "Node") {
        self.current_name = name
        self.current_children = []
        self.current_inside_tree = false
        self.current_dirty = false
        self.current_synchronization_registered = false
        self.current_process_enabled = false
        self.current_process_configured = false
        self.current_process_registered = false
        self.current_processing = false
        self.current_ready_count = 0
        self.current_process_delta = 0.0
    }

    func name() str { return self.current_name }
    func parent() Node? { return self.current_parent }
    func children() Node[] { return self.current_children }
    func child_count() int { return self.current_children.count() }
    func child(index:int) Node { return self.current_children[index] }
    func entity() ECS.Entity? { return self.current_entity }
    func is_inside_tree() bool { return self.current_inside_tree }
    func ready_count() int { return self.current_ready_count }
    func process_delta() float { return self.current_process_delta }
    func is_processing() bool { return self.current_process_enabled }

    func set_process(enabled:bool) {
        self.current_process_configured = true
        if self.current_process_enabled == enabled { return }
        self.current_process_enabled = enabled
        if enabled && self.current_inside_tree && !self.current_process_registered {
            self.current_tree!.register_process(self)
            self.current_process_registered = true
        }
    }

    func path() str {
        if var parent = self.current_parent {
            return "$(parent.path())/$(self.current_name)"
        }
        return "/$(self.current_name)"
    }

    func add_child(child:Node) Node {
        if self.current_inside_tree {
            panic("runtime Node attachment is not implemented")
        }
        if child == self {
            panic("a Node cannot be its own child")
        }
        if child.current_parent != null {
            panic("Node '$(child.name())' already has a parent")
        }
        if self.is_below(child) {
            panic("adding Node '$(child.name())' would create a cycle")
        }
        if self.has_child_named(child.name()) {
            panic("Node '$(self.path())' already has a child named '$(child.name())'")
        }

        child.current_parent = self
        self.current_children.append(child)
        return self
    }

    func remove_child(child:Node) Node? {
        if self.current_inside_tree {
            panic("runtime Node detachment is not implemented")
        }
        var index = 0
        while index < self.current_children.count() {
            if self.current_children[index] == child {
                var removed = self.current_children.take(index)
                removed.current_parent = null
                return removed
            }
            index++
        }
        return null
    }

    protected func mount_components(world:&ECS.World, entity:ECS.Entity) {
        self.current_entity = entity
    }

    protected func synchronize(world:&ECS.World, entity:ECS.Entity) {}

    protected func changed() {
        self.mark_changed()
        if self.current_inside_tree && !self.current_processing &&
            !self.current_synchronization_registered
        {
            self.current_tree!.register_synchronization(self)
            self.current_synchronization_registered = true
        }
    }

    protected func mark_changed() { self.current_dirty = true }

    protected func changes_are_deferred() bool { return self.current_processing }

    protected func invalidate_children_2d(deferred:bool) {
        for child in self.current_children {
            child.parent_transform_2d_changed(deferred)
        }
    }

    protected func invalidate_children_3d(deferred:bool) {
        for child in self.current_children {
            child.parent_transform_3d_changed(deferred)
        }
    }

    protected func flush_children_2d(world:&ECS.World) {
        var children = self.current_children
        for var child in children {
            child.flush_parent_transform_2d(world)
        }
    }

    protected func flush_children_3d(world:&ECS.World) {
        var children = self.current_children
        for var child in children {
            child.flush_parent_transform_3d(world)
        }
    }

    protected func parent_transform_2d_changed(deferred:bool) {}
    protected func parent_transform_3d_changed(deferred:bool) {}
    protected func flush_parent_transform_2d(world:&ECS.World) {}
    protected func flush_parent_transform_3d(world:&ECS.World) {}

    private func ready() {
        self.current_ready_count++
        self.on_ready()
    }

    private func process(delta:float) {
        self.current_process_delta = delta
        self.on_process(delta)
    }

    private func exit_tree() {
        self.on_exit_tree()
        self.current_inside_tree = false
    }

    protected func on_ready() {}
    protected func on_process(delta:float) {}
    protected func on_exit_tree() {}

    module func mount_subtree(world:&ECS.World, tree:SceneTree) {
        if self.current_inside_tree {
            panic("Node '$(self.path())' is already inside a SceneTree")
        }
        let entity = world.spawn(ECS.EntityRecipe())
        self.current_tree = tree
        self.current_inside_tree = true
        self.current_dirty = false
        self.current_synchronization_registered = false
        if !self.current_process_configured {
            self.current_process_enabled = !Text.starts_with(
                reflect(self).type,
                "GFX.Nodes."
            )
        }
        if self.current_process_enabled {
            tree.register_process(self)
            self.current_process_registered = true
        }
        self.mount_components(world, entity)

        var children = self.current_children
        for var child in children {
            child.mount_subtree(world, tree)
        }
        self.ready()
        self.flush_synchronization(world)
    }

    module func process_frame(delta:float, world:&ECS.World) {
        if !self.current_inside_tree {
            panic("Node '$(self.path())' is outside the SceneTree")
        }
        if !self.current_process_enabled { return }
        self.current_processing = true
        self.process(delta)
        self.current_processing = false
        if self.current_dirty {
            self.current_dirty = false
            self.current_synchronization_registered = false
            self.synchronize(world, self.current_entity!)
        }
    }

    module func flush_synchronization(world:&ECS.World) {
        if !self.current_dirty { return }
        self.current_dirty = false
        self.current_synchronization_registered = false
        self.synchronize(world, self.current_entity!)
    }

    module func unmount_subtree(world:&ECS.World) {
        if !self.current_inside_tree { return }
        var children = self.current_children
        for var child in children {
            child.unmount_subtree(world)
        }
        self.exit_tree()
        world.destroy(self.current_entity!)
        self.current_entity = null
        self.current_tree = null
        self.current_dirty = false
        self.current_synchronization_registered = false
        self.current_process_registered = false
        self.current_processing = false
    }

    module func print_branch(indent:str) {
        print("$(indent)$(self.name()) [$(reflect(self).type)]")
        for child in self.current_children {
            child.print_branch("$(indent)  ")
        }
    }

    private func has_child_named(name:str) bool {
        for child in self.current_children {
            if child.name() == name { return true }
        }
        return false
    }

    private func is_below(candidate:Node) bool {
        var ancestor = self.current_parent
        while var current = ancestor {
            if current == candidate { return true }
            ancestor = current.current_parent
        }
        return false
    }
}
