use GFX.ECS
use GFX.Scene2D
use STD.Math

public class Camera2D:Node2D {
    private var current_camera:Scene2D.Camera
    private var camera_dirty:bool

    var active:bool {
        get { return self.current_camera.active }
        set(value) {
            if self.current_camera.active == value { return }
            self.current_camera.active = value
            self.camera_changed()
        }
    }

    var zoom:float {
        get { return self.current_camera.zoom }
        set(value) {
            if self.current_camera.zoom == value { return }
            self.current_camera.zoom = value
            self.camera_changed()
        }
    }

    var viewport_size:Math.Vec2 {
        get { return self.current_camera.viewport_size }
        set(value) {
            if self.current_camera.viewport_size == value { return }
            self.current_camera.viewport_size = value
            self.camera_changed()
        }
    }

    var order:int {
        get { return self.current_camera.order }
        set(value) {
            if self.current_camera.order == value { return }
            self.current_camera.order = value
            self.camera_changed()
        }
    }

    init(
        name:str = "Camera2D",
        active:bool = true,
        zoom:float = 1.0,
        viewport_size:Math.Vec2 = Math.Vec2(),
        order:int = 0
    ):super(name) {
        self.current_camera = Scene2D.Camera(
            active:active,
            zoom:zoom,
            viewport_size:viewport_size,
            order:order
        )
        self.camera_dirty = false
    }

    override func mount_components(world:&ECS.World, entity:ECS.Entity) {
        super.mount_components(world, entity)
        world.insert(entity, self.current_camera)
        self.camera_dirty = false
    }

    override func synchronize(world:&ECS.World, entity:ECS.Entity) {
        super.synchronize(world, entity)
        if !self.camera_dirty { return }
        world.insert(entity, self.current_camera)
        self.camera_dirty = false
    }

    private func camera_changed() {
        if self.camera_dirty { return }
        self.camera_dirty = true
        self.changed()
    }
}
