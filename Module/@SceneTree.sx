use GFX.Application
use GFX.ECS
use GFX.Input
use GFX.Scene2D
use GFX.Scene3D
use GFX.Physics
use Interop.C

public class SceneTree {
    private var scene_2d_requested:bool = false
    private var scene_3d_requested:bool = false
    private var scene_2d_pending:bool = false
    private var scene_3d_pending:bool = false

    module func require_scene_2d() {
        if self.scene_2d_requested { return }
        self.scene_2d_requested = true
        self.scene_2d_pending = true
    }

    module func require_scene_3d() {
        if self.scene_3d_requested { return }
        self.scene_3d_requested = true
        self.scene_3d_pending = true
    }

    module func install_required_plugins(application:&Application) {
        if self.scene_2d_pending {
            application.require_plugin(Scene2D.Plugin())
            self.scene_2d_pending = false
        }
        if self.scene_3d_pending {
            application.require_plugin(Scene3D.Plugin())
            self.scene_3d_pending = false
        }
    }

    module func has_input() bool { return self.current_input != null }

    private var physics_observers:Node[] = []
    private var physics_bodies:Node[] = []
    private var sensor_snapshot:Physics.SensorOverlap2D[] = []
    private var deferred_events:DeferredEvent[] = []

    module func queue_event(event:DeferredEvent) { self.deferred_events.append(event) }

    private func flush_events(world:&ECS.World) {
        // One batch per boundary. Events emitted by deferred handlers wait for
        // the next boundary, so a feedback loop cannot monopolize this pass.
        var pending = self.deferred_events
        self.deferred_events = []
        for var event in pending { event.dispatch() }
        self.flush_mutations(world)
        self.flush_synchronizations(world)
    }

    private var callback_resources_address:uint = 0
    private var current_input:Input.State? = null
    private var current_root:Node
    private var current_running:bool
    private var current_frame:int
    private var current_process_nodes:Node[]
    private var current_dirty_nodes:Node[]
    private var current_physics_nodes:Node[] = []
    private var pending_attachments:Node[] = []
    private var pending_detachments:Node[] = []

    init(root:Node) {
        self.current_root = root
        self.current_running = false
        self.current_frame = 0
        self.current_process_nodes = []
        self.current_dirty_nodes = []
    }

    func root() Node { return self.current_root }
    func is_running() bool { return self.current_running }
    func frame() int { return self.current_frame }

    // A simulation driver calls this once per fixed step, outside ECS query iteration.
    module func process_physics(delta:float, callback_resources:Application.Resources) {
        var resources = callback_resources
        if !self.current_running { return }
        if delta <= 0.0 || delta != delta || delta + delta == delta {
            panic("SceneTree.process_physics requires a finite positive delta")
        }
        let paused = resources.get<Application.Simulation>().is_paused()
        if paused { return }
        let address = C.object_address(resources)
        var world = resources.get_mut<ECS.World>()
        self.begin_callbacks(address)
        self.flush_mutations(world)
        self.flush_synchronizations(world)
        let count = self.current_physics_nodes.count()
        var index = 0
        while index < count {
            var node = self.current_physics_nodes[index]
            if node.can_process(self) { node.flush_synchronization(world) }
            if node.can_process(self) && node.is_physics_processing() &&
                node.processes_while(paused)
            {
                node.process_physics_step(delta, world)
            }
            index++
        }
        self.flush_mutations(world)
        self.flush_synchronizations(world)
        self.end_callbacks()
    }

    module func register_physics_body(node:Node) { self.physics_bodies.append(node) }
    module func register_physics_observer(node:Node) { self.physics_observers.append(node) }

    module func body_contact(body:Physics.RigidBody2D) BodyContact2D {
        var world = self.resources().get<ECS.World>()
        for node in self.physics_bodies {
            if !node.can_process(self) { continue }
            let entity = node.entity()!
            if world.has<Physics.PhysicsBody2D>(entity) {
                if let candidate = world.get<Physics.PhysicsBody2D>(entity).body() {
                    if body.same_body(candidate) { return BodyContact2D(body, node) }
                }
            }
        }
        return BodyContact2D(body, null)
    }

    module func complete_physics(callback_resources:Application.Resources) {
        if !self.current_running { return }
        var resources = callback_resources
        let address = C.object_address(resources)
        var world = resources.get_mut<ECS.World>()
        self.begin_callbacks(address)
        // Copy the physics snapshot once per completed step for every area.
        self.resources().get<Physics.World2D>().write_sensor_overlaps(self.sensor_snapshot)
        let count = self.physics_observers.count()
        var index = 0
        while index < count {
            var node = self.physics_observers[index]
            if node.can_process(self) { node.physics_step_completed(self.sensor_snapshot) }
            index++
        }
        self.flush_mutations(world)
        self.flush_synchronizations(world)
        self.flush_events(world)
        self.end_callbacks()
    }

    // The calling system owns the store for this synchronous lifecycle pass.
    // Keep a non-owning identity only until end_callbacks: retaining the store
    // here would make every node cycle check traverse all application resources.
    module func begin_callbacks(resources_address:uint) {
        if self.callback_resources_address != 0 {
            panic("SceneTree lifecycle callbacks cannot be nested")
        }
        self.callback_resources_address = resources_address
    }

    module func end_callbacks() {
        self.callback_resources_address = 0
    }

    module func resources() Application.Resources {
        if self.callback_resources_address == 0 {
            panic("Node resources are only available during lifecycle callbacks")
        }
        return C.object_from_address<Application.Resources>(self.callback_resources_address)
    }

    // Retain only the shared input state, never the application's resource
    // store: that back-reference makes each cycle check trace the whole scene.
    module func bind_input(input:Input.State?) {
        self.current_input = input
    }

    module func start(world:&ECS.World) {
        if self.current_running { panic("SceneTree is already running") }
        self.current_process_nodes.clear()
        self.current_physics_nodes.clear()
        self.current_dirty_nodes.clear()
        if self.current_root.parent() != null {
            panic("SceneTree root must not have a parent")
        }
        self.current_running = true
        self.current_root.mount_subtree(world, self)
        self.flush_mutations(world)
        self.flush_synchronizations(world)
        self.flush_events(world)
    }

    module func process(delta:float, paused:bool, world:&ECS.World) {
        if !self.current_running {
            panic("SceneTree must be started before processing")
        }
        self.flush_mutations(world)
        self.flush_synchronizations(world)
        let node_count = self.current_process_nodes.count()
        var index = 0
        while index < node_count {
            var node = self.current_process_nodes[index]
            if node.can_process(self) { node.flush_synchronization(world) }
            if node.can_process(self) && node.is_processing() &&
                node.processes_while(paused)
            {
                node.process_frame(delta, world)
            }
            index++
        }
        self.flush_mutations(world)
        self.flush_synchronizations(world)
        self.flush_events(world)
        self.current_frame++
    }

    module func stop(world:&ECS.World) {
        if !self.current_running { return }
        self.current_running = false
        self.pending_detachments.append(self.current_root)
        self.flush_detachments(world)
        self.current_process_nodes.clear()
        self.current_dirty_nodes.clear()
        self.pending_attachments.clear()
        self.current_physics_nodes.clear()
        self.pending_detachments.clear()
        self.current_input = null
        self.deferred_events.clear()
        self.physics_observers.clear()
        self.physics_bodies.clear()
        self.sensor_snapshot.clear()
    }

    module func input() @Input.State {
        if self.current_input == null {
            panic("Node input requires Plugins.Input or Plugins.Window before Plugins.Nodes")
        }
        return self.current_input!
    }

    module func register_attachment(node:Node) {
        if self.current_running { self.pending_attachments.append(node) }
    }

    module func register_detachment(node:Node) {
        self.pending_detachments.append(node)
    }

    module func register_process(node:Node) {
        self.current_process_nodes.append(node)
    }

    module func register_physics_process(node:Node) {
        self.current_physics_nodes.append(node)
    }

    module func register_synchronization(node:Node) {
        self.current_dirty_nodes.append(node)
    }

    // These queues are empty on unchanged frames. Registry compaction happens
    // only after removals, once per batch, before any node can be mounted again.
    private func flush_detachments(world:&ECS.World) {
        if self.pending_detachments.count() == 0 { return }
        while self.pending_detachments.count() > 0 {
            var pending = self.pending_detachments
            self.pending_detachments = []
            for var node in pending {
                if node.belongs_to(self) { node.unmount_subtree(world) }
            }
        }
        var processing = self.current_process_nodes
        self.current_process_nodes = []
        for node in processing {
            if node.can_process(self) { self.current_process_nodes.append(node) }
        }
        var observers = self.physics_observers
        self.physics_observers = []
        for node in observers { if node.can_process(self) { self.physics_observers.append(node) } }
        var bodies = self.physics_bodies
        self.physics_bodies = []
        for node in bodies { if node.can_process(self) { self.physics_bodies.append(node) } }
        var dirty = self.current_dirty_nodes
        var physics = self.current_physics_nodes
        self.current_physics_nodes = []
        for node in physics {
            if node.can_process(self) { self.current_physics_nodes.append(node) }
        }
        self.current_dirty_nodes = []
        for node in dirty {
            if node.can_process(self) { self.current_dirty_nodes.append(node) }
        }
    }

    private func flush_mutations(world:&ECS.World) {
        self.flush_detachments(world)
        while self.pending_attachments.count() > 0 {
            var pending = self.pending_attachments
            self.pending_attachments = []
            for var node in pending {
                self.flush_detachments(world)
                if node.can_attach(self) { node.mount_subtree(world, self) }
            }
            self.flush_detachments(world)
        }
    }

    func print_tree() {
        self.current_root.print_branch("")
    }

    private func flush_synchronizations(world:&ECS.World) {
        while !self.current_dirty_nodes.is_empty() {
            var pending = self.current_dirty_nodes
            self.current_dirty_nodes = []
            for var node in pending {
                if node.can_process(self) { node.flush_synchronization(world) }
            }
        }
    }
}
