use GFX.ECS
use GFX.Scene3D
use STD.Math

public class Node3D:Node {
    private var local_transform:Scene3D.Transform
    private var transform_dirty:bool
    private var spatial_parent:Node? = null
    private var spatial_parent_entity:ECS.Entity? = null

    var position:Math.Vec3 {
        get { return self.local_transform.position }
        set(value) {
            if self.local_transform.position == value { return }
            self.local_transform.position = value
            self.transform_changed()
        }
    }

    var rotation:Math.Quat {
        get { return self.local_transform.rotation }
        set(value) {
            if self.local_transform.rotation == value { return }
            self.local_transform.rotation = value
            self.transform_changed()
        }
    }

    var scale:Math.Vec3 {
        get { return self.local_transform.scale }
        set(value) {
            if self.local_transform.scale == value { return }
            self.local_transform.scale = value
            self.transform_changed()
        }
    }

    init(
        name:str = "Node3D",
        position:Math.Vec3 = Math.Vec3(),
        rotation:Math.Quat = Math.Quat(),
        scale:Math.Vec3 = Math.Vec3(1.0)
    ):super(name) {
        self.local_transform = Scene3D.Transform(
            position:position,
            rotation:rotation,
            scale:scale
        )
        self.transform_dirty = false
    }

    func transform() Scene3D.Transform { return self.local_transform }

    override func mount_components(world:&ECS.World, entity:ECS.Entity) {
        super.mount_components(world, entity)
        self.spatial_parent = null
        self.spatial_parent_entity = null
        if var parent = self.parent() {
            let candidate:ECS.Entity? = parent.entity()
            if candidate != null {
                let parent_entity:ECS.Entity = candidate!
                if world.has<Scene3D.Transform>(parent_entity) {
                    self.spatial_parent = parent
                    self.spatial_parent_entity = parent_entity
                }
            }
        }
        world.insert(entity, self.global_transform(world))
        self.transform_dirty = false
    }

    override func synchronize(world:&ECS.World, entity:ECS.Entity) {
        super.synchronize(world, entity)
        if !self.transform_dirty { return }
        if var parent = self.spatial_parent { parent.flush_synchronization(world) }
        world.insert(entity, self.global_transform(world))
        self.transform_dirty = false
        if self.child_count() > 0 { self.flush_children_3d(world) }
    }

    override func parent_transform_3d_changed(deferred:bool) {
        if self.transform_dirty { return }
        self.transform_dirty = true
        self.mark_changed()
        if deferred {
            self.invalidate_children_3d(true)
            return
        }
        self.changed()
        self.invalidate_children_3d(false)
    }

    override func flush_parent_transform_3d(world:&ECS.World) {
        self.flush_synchronization(world)
    }

    private func transform_changed() {
        if self.transform_dirty { return }
        self.transform_dirty = true
        self.changed()
        self.invalidate_children_3d(self.changes_are_deferred())
    }

    private func global_transform(world:@ECS.World) Scene3D.Transform {
        var global = self.local_transform
        if let parent_entity = self.spatial_parent_entity {
            global = compose_transform(
                world.get<Scene3D.Transform>(parent_entity),
                self.local_transform
            )
        }
        return global
    }
}

func compose_transform(
    parent:Scene3D.Transform,
    child:Scene3D.Transform
) Scene3D.Transform {
    let scaled = child.position.multiply(parent.scale)
    return Scene3D.Transform(
        position:parent.position.add(parent.rotation.rotate(scaled)),
        rotation:parent.rotation.multiply(child.rotation).normalized(),
        scale:parent.scale.multiply(child.scale)
    )
}
