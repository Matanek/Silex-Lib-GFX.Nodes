use GFX.Application
use GFX.Assets.Image
use GFX.Canvas
use GFX.Color
use GFX.Nodes
use GFX.Plugins
use GFX.Rendering
use GFX.Scene2D
use GFX.Scene3D
use GFX.Window.Plugin as WindowPlugin
use STD.Math

class RenderedRoot:Nodes.Node {
    var visual:Nodes.Node
    var checks:int = 0
    let three_dimensional:bool

    init(three_dimensional:bool):super("Root") {
        self.three_dimensional = three_dimensional
        self.visual = Nodes.Node("Visual")
        self.add_child(self.visual)
    }

    override func on_ready() {
        if self.three_dimensional {
            var camera = Nodes.Camera3D()..position = Math.Vec3(0.0, 0.0, 5.0)
            self.add_child(camera)
            var resources = self.resources()
            var images = resources.get_mut<Image.Store>()
            let image = images.add(Image.solid(Color.white()))
            self.visual.add_child(Nodes.Sprite3D(image))
        } else {
            var canvas = Nodes.Canvas2D()
            canvas.paint(func(painter:&Canvas.Painter) {
                painter.fill(Canvas.Circle(Math.Vec2(), 8.0), Canvas.Fill.solid(Color.white()))
            })
            self.visual.add_child(canvas)
        }
    }
}

func check_render(root:&RenderedRoot, renderer:@Rendering.Renderer, controller:&Application.Controller) {
    if root.checks == 1 {
        assert(renderer.stats().draw_calls() == 0)
        assert(renderer.stats().instances() == 0)
        root.visual.enable(true)
    } else {
        assert(renderer.stats().draw_calls() == 1)
        assert(renderer.stats().instances() == 1)
        if root.checks == 0 { root.visual.enable(false) }
        else { controller.stop() }
    }
    root.checks++
}

test "inactive visual branches leave and rejoin both scene renderers" {
    for three_dimensional in [false, true] {
        var root = RenderedRoot(three_dimensional)
        var application = Application()
            ..add_resource(root)
            ..add_plugin(WindowPlugin(WindowPlugin.Settings()
                ..title = "Node activation"
                ..width = 64
                ..height = 64
                ..hidden = true))
            ..add_plugin(Rendering.Plugin())
        if three_dimensional { application.add_plugin(Scene3D.Plugin()) }
        else { application.add_plugin(Scene2D.Plugin()) }
        application.add_plugin(Plugins.Nodes(root))
        application.add_after_system(Application.Schedule.render, check_render)
        assert(application.run() == 0)
        assert(root.checks == 3)
    }
}
