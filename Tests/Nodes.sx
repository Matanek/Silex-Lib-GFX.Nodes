use GFX.Application
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Nodes
use GFX.Scene2D
use GFX.Scene3D
use STD.Math

class Actor2D:Nodes.Node2D {
    var ready_calls:int
    var process_calls:int
    var exit_calls:int

    init():super("Actor2D", Math.Vec2(10.0, 20.0)) {
        self.ready_calls = 0
        self.process_calls = 0
        self.exit_calls = 0
    }

    override func on_ready() { self.ready_calls++ }
    override func on_process(delta:float) { self.process_calls++ }
    override func on_exit_tree() { self.exit_calls++ }
}

test "mount object nodes as ECS entities and preserve dimensional ownership" {
    var actor = Actor2D()
    var drawing = Nodes.Canvas2D("Drawing")
    drawing.position = Math.Vec2(5.0, 2.0)
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Circle(Math.Vec2(), 4.0),
            Canvas.Fill.solid(Color.white())
        )
    })
    actor.add_child(drawing)

    var spatial_3d = Nodes.Node3D(
        "Spatial3D",
        Math.Vec3(1.0, 2.0, 3.0)
    )
    var root = Nodes.Node("Root")
    root.add_child(actor)
    root.add_child(spatial_3d)

    var application = Application()
        ..add_plugin(Nodes.Plugin(root))
    application.prepare()
    application.run_schedule(Application.Schedule.startup)

    var resources = application.resources()
    var world:@ECS.World = resources.get<ECS.World>()
    let root_entity:ECS.Entity = root.entity()!
    let actor_entity:ECS.Entity = actor.entity()!
    let drawing_entity:ECS.Entity = drawing.entity()!
    let spatial_3d_entity:ECS.Entity = spatial_3d.entity()!

    assert(!world.has<Scene2D.Transform>(root_entity))
    assert(!world.has<Scene3D.Transform>(root_entity))
    assert(world.has<Scene2D.Transform>(actor_entity))
    assert(world.has<Scene2D.Transform>(drawing_entity))
    assert(world.has<Scene2D.Canvas>(drawing_entity))
    assert(world.has<Scene3D.Transform>(spatial_3d_entity))
    assert(world.get<Scene2D.Transform>(drawing_entity).position ==
        Math.Vec2(15.0, 22.0))
    assert(world.get<Scene3D.Transform>(spatial_3d_entity).position ==
        Math.Vec3(1.0, 2.0, 3.0))
    assert(actor.ready_calls == 1)
    assert(drawing.command_count() == 1)

    application.run_schedule(Application.Schedule.pre_update)
    application.run_schedule(Application.Schedule.update)
    assert(actor.process_calls == 1)

    application.run_schedule(Application.Schedule.shutdown)
    assert(actor.exit_calls == 1)
    assert(actor.entity() == null)
    assert(drawing.entity() == null)
    assert(spatial_3d.entity() == null)
}

test "report the complete dynamic node ancestry" {
    var actor:Nodes.Node = Actor2D()
    let identity = reflect(actor)

    assert(identity.type == "Actor2D")
    assert(identity.types.count() == 3)
    assert(identity.types[0] == "GFX.Nodes.Node")
    assert(identity.types[1] == "GFX.Nodes.Node2D")
    assert(identity.types[2] == "Actor2D")
}

test "mount and synchronize camera and sprite nodes" {
    var camera_2d = Nodes.Camera2D(
        name:"Camera2D",
        zoom:2.0,
        viewport_size:Math.Vec2(1280.0, 720.0),
        order:1
    )
    var sprite_2d = Nodes.Sprite2D(
        name:"Sprite2D",
        size:Math.Vec2(32.0, 48.0),
        layer:2,
        depth:0.25
    )
    var camera_3d = Nodes.Camera3D(
        name:"Camera3D",
        vertical_fov:0.8,
        near_plane:0.2,
        far_plane:500.0,
        order:3
    )
    var sprite_3d = Nodes.Sprite3D(
        name:"Sprite3D",
        size:Math.Vec2(3.0, 4.0),
        billboard:Scene3D.Billboard.none
    )
    var root = Nodes.Node("Root")
    root.add_child(camera_2d)
    root.add_child(sprite_2d)
    root.add_child(camera_3d)
    root.add_child(sprite_3d)

    var application = Application()
        ..add_plugin(Nodes.Plugin(root))
    application.prepare()
    application.run_schedule(Application.Schedule.startup)

    var resources = application.resources()
    var world:@ECS.World = resources.get<ECS.World>()
    let camera_2d_entity:ECS.Entity = camera_2d.entity()!
    let sprite_2d_entity:ECS.Entity = sprite_2d.entity()!
    let camera_3d_entity:ECS.Entity = camera_3d.entity()!
    let sprite_3d_entity:ECS.Entity = sprite_3d.entity()!

    assert(world.has<Scene2D.Transform>(camera_2d_entity))
    assert(world.has<Scene2D.Camera>(camera_2d_entity))
    assert(world.has<Scene2D.Transform>(sprite_2d_entity))
    assert(world.has<Scene2D.Sprite>(sprite_2d_entity))
    assert(world.has<Scene3D.Transform>(camera_3d_entity))
    assert(world.has<Scene3D.Camera>(camera_3d_entity))
    assert(world.has<Scene3D.Transform>(sprite_3d_entity))
    assert(world.has<Scene3D.Sprite>(sprite_3d_entity))
    assert(world.get<Scene2D.Camera>(camera_2d_entity).zoom == 2.0)
    assert(world.get<Scene2D.Sprite>(sprite_2d_entity).layer == 2)
    assert(world.get<Scene3D.Camera>(camera_3d_entity).far_plane == 500.0)
    assert(world.get<Scene3D.Sprite>(sprite_3d_entity).billboard ==
        Scene3D.Billboard.none)

    camera_2d.active = false
    camera_2d.zoom = 3.0
    sprite_2d.visible = false
    sprite_2d.layer = 7
    camera_3d.use_orthographic(12.0)
    camera_3d.order = 8
    sprite_3d.visible = false
    sprite_3d.billboard = Scene3D.Billboard.face_camera_y
    application.run_schedule(Application.Schedule.update)

    let updated_camera_2d = world.get<Scene2D.Camera>(camera_2d_entity)
    let updated_sprite_2d = world.get<Scene2D.Sprite>(sprite_2d_entity)
    let updated_camera_3d = world.get<Scene3D.Camera>(camera_3d_entity)
    let updated_sprite_3d = world.get<Scene3D.Sprite>(sprite_3d_entity)
    assert(!updated_camera_2d.active)
    assert(updated_camera_2d.zoom == 3.0)
    assert(!updated_sprite_2d.visible)
    assert(updated_sprite_2d.layer == 7)
    assert(updated_camera_3d.is_orthographic())
    assert(updated_camera_3d.order == 8)
    assert(!updated_sprite_3d.visible)
    assert(updated_sprite_3d.billboard == Scene3D.Billboard.face_camera_y)

    application.run_schedule(Application.Schedule.shutdown)
}
